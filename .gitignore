# Dependencies (always regenerated by npm install)
node_modules
server/node_modules

# Build output (regenerated by npm run build)
dist

# Local environment files (never commit secrets)
.env
server/.env

# Local database + uploaded files (must NOT be in the repo;
# in production these live on the host's persistent disk)
server/data.db
server/data.db-shm
server/data.db-wal
server/uploads/books/*
server/uploads/papers/*
!server/uploads/books/.gitkeep
!server/uploads/papers/.gitkeep

# Logs & OS junk
*.log
npm-debug.log*
.DS_Store
Thumbs.db
.vscode
