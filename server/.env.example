# Copy this file to ".env" and adjust as needed.

# Port the API listens on
PORT=4000

# Secret used to sign JWT tokens. CHANGE THIS to a long random string in production.
JWT_SECRET=change-me-to-a-long-random-secret

# Default admin account created on first run (only used when the users table is empty)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=menya2026

# Comma-separated list of allowed frontend origins (CORS)
CORS_ORIGIN=http://localhost:5173,http://localhost:4173

# Production storage paths (point these at a persistent disk on your host)
# DB_PATH=/var/data/data.db
# UPLOAD_DIR=/var/data/uploads
